# Copy to .env and adjust as needed. Never commit backend/.env.
# Start the backend with: .venv/bin/uvicorn app.main:app --env-file .env
#
# Local summarization (Module 5, Task 5.6) — used by the summary endpoint
# POST /api/v1/memories/{id}/summary. The base URL must be a loopback host;
# anything else is rejected before a request is made, so memory text never
# leaves this machine. Install Ollama, then: ollama pull llama3.2
# and keep it running with: ollama serve
RECALLAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
RECALLAI_OLLAMA_MODEL=llama3.2
RECALLAI_OLLAMA_TIMEOUT_SECONDS=30
RECALLAI_MAX_SUMMARY_INPUT_CHARS=30000

# Hosted Gemini configuration (Module 5, Task 5.2) — retained for the isolated
# GeminiSummarizationService; NOT used by the summary endpoint.
RECALLAI_GEMINI_API_KEY=
RECALLAI_GEMINI_MODEL=gemini-3.8-flash
RECALLAI_GEMINI_TIMEOUT_SECONDS=30

# Retrieval / Ask RecallAI (Module 6). All values below are the defaults;
# uncomment to override. The embedding model must be local and loopback —
# the base URL is validated the same way as RECALLAI_OLLAMA_BASE_URL above.
# Install Ollama, then: ollama pull nomic-embed-text
RECALLAI_EMBEDDING_MODEL=nomic-embed-text
RECALLAI_EMBEDDING_TIMEOUT_SECONDS=60
RECALLAI_MAX_EMBEDDING_INPUT_CHARS=6000

# Chunking (Task 6.1)
RECALLAI_RAG_CHUNK_SIZE=1200
RECALLAI_RAG_CHUNK_OVERLAP=150

# Retrieval tuning (Tasks 6.4–6.6). Candidates = per-channel pool before RRF;
# top_k = passages returned; min_similarity = cosine floor for the semantic
# channel; weights/rrf_k control hybrid ranking (score = w/(k + rank)).
RECALLAI_RAG_CANDIDATES=20
RECALLAI_RAG_TOP_K=6
RECALLAI_RAG_MIN_SIMILARITY=0.25
RECALLAI_RAG_SEMANTIC_WEIGHT=1.0
RECALLAI_RAG_KEYWORD_WEIGHT=1.0
RECALLAI_RAG_RRF_K=60

# Prompt + confidence (Tasks 6.7–6.9)
RECALLAI_RAG_EVIDENCE_BUDGET_CHARS=6000
RECALLAI_RAG_MAX_QUESTION_CHARS=1000
RECALLAI_RAG_CONFIDENCE_WEAK=0.35
RECALLAI_RAG_CONFIDENCE_STRONG=0.55
RECALLAI_RAG_MIN_EVIDENCE_FOR_STRONG=2

# Voice input & speech-to-text (Module 9, Task 82). The worker runs in an
# isolated Python 3.12 venv (backend/.venv-voice) and never shares dependencies
# with the main RecallAI server. The model is downloaded once to the HF cache
# on first use; subsequent requests are fully offline.
RECALLAI_VOICE_PYTHON=backend/.venv-voice/bin/python
RECALLAI_VOICE_MODEL=tiny
RECALLAI_VOICE_MAX_AUDIO_BYTES=10485760
RECALLAI_VOICE_MAX_DURATION_SECONDS=120
RECALLAI_VOICE_TIMEOUT_SECONDS=120
