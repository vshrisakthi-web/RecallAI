{
  "name": "recallai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RecallAI — privacy-first personal AI memory assistant (Module 1 UI with mock data)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "icons:extension": "node extension/scripts/gen-icons.mjs",
    "build:extension": "npm run icons:extension && npm run build:ext:app && npm run build:ext:content && npm run build:ext:background && node extension/scripts/assemble.mjs && node extension/scripts/verify-dist.mjs",
    "build:ext:app": "vite build --config extension/vite.config.ts",
    "build:ext:content": "vite build --config extension/vite.content.config.ts",
    "build:ext:background": "vite build --config extension/vite.background.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
